{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/*)",
      "Bash(.claude/scripts/py *)",
      "Bash(.claude/scripts/node *)",
      "Bash(bash .claude/tools/setup_tools.sh --system)",
      "Bash(vectorcraft-cli convert *)",
      "Bash(vectorcraft-cli commands*)",
      "Bash(effectcraft-cli commands*)",
      "Bash(effectcraft-cli info*)",
      "Bash(ffprobe *)",
      "Bash(pdfinfo *)",
      "Bash(pdffonts *)",
      "Bash(fc-list*)",
      "mcp__vectorcraft",
      "mcp__effectcraft",
      "mcp__figcraft",
      "mcp__photocraft",
      "Bash(figcraft-cli info *)",
      "Bash(figcraft-cli export *)",
      "Bash(figcraft-cli render *)",
      "Bash(figcraft-cli run *)",
      "Bash(figcraft-cli commands*)",
      "Bash(photocraft-cli info *)",
      "Bash(photocraft-cli convert *)",
      "Bash(photocraft-cli commands*)",
      "Bash(photocraft-cli run *)",
      "Bash(photocraft-cli batch *)",
      "Bash(mkdir -p work/*)",
      "Bash(vectorcraft-cli info *)",
      "Bash(vectorcraft-cli run *)",
      "Bash(effectcraft-cli run *)",
      "Bash(effectcraft-cli render*)",
      "Bash(effectcraft-cli script *)",
      "Bash(effectcraft-cli props *)",
      "Bash(effectcraft-cli get *)",
      "Bash(effectcraft-cli set *)",
      "Bash(vectorcraft-cli --help*)",
      "Bash(effectcraft-cli --help*)",
      "Bash(figcraft-cli --help*)",
      "Bash(photocraft-cli --help*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__vectorcraft__.*|mcp__effectcraft__.*|mcp__figcraft__.*|mcp__photocraft__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/craft-guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/isolation-guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/identity-guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/budget-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/observe-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "12000"
  }
}
