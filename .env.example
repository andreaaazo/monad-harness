# Copia in .env. Non committare mai la chiave.
ANTHROPIC_API_KEY=
# Dove vivono registro, checkpoint e artefatti locali.
AGENCY_DATA_DIR=.data
# Budget di default in dollari, se agency run non indica --budget.
AGENCY_PROJECT_BUDGET_USD=25
# Effort di esplorazione e proposte (high o medium).
AGENCY_EXPLORER_EFFORT=high
AGENCY_PROPOSAL_EFFORT=high
AGENCY_EXPLORERS=5
AGENCY_MAX_PARALLEL=5
