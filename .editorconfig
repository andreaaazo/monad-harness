# The editors' shared settings (https://editorconfig.org): what Ruff and the versioned files already do, so an
# editor keeps them as they are. legacy/ is frozen and never edited.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The line length is Ruff's, in pyproject.toml; a test keeps the two equal.
[*.py]
indent_size = 4
max_line_length = 110

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab

# Generated files keep their generator's indent: a change by hand is lost at the next run.
[{uv.lock,web/src/api/schema.ts}]
indent_size = 4
